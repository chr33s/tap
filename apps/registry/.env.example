# Loopback HTTP is only for development. Any other bind address requires TLS_CERT_FILE and TLS_KEY_FILE.
HOST=127.0.0.1
PORT=9002

# Required. Send as: Authorization: Bearer <token>
TAP_ADMIN_TOKEN=replace-with-a-long-random-admin-token

TAP_DATABASE_PATH=./data/registry.db

# TLS_CERT_FILE=./certs/registry.crt
# TLS_KEY_FILE=./certs/registry.key
