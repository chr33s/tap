HOST=127.0.0.1
PORT=3001

# Request URL the agent signs. The proxy verifies that URL, then forwards to UPSTREAM_URL.
UPSTREAM_URL=http://127.0.0.1:8080
REGISTRY_URL=http://127.0.0.1:9002
TAP_PROFILE=tap
# Stable replay namespace. Do not take this from the request.
TAP_TRUST_SOURCE=registry:http://127.0.0.1:9002

# JSON arrays. A request must match a protected route or an explicit public route.
# Revocation can lag by at most min(TAP_CACHE_TTL_MS, 30000ms, key expires_at).
TAP_PROTECTED_ROUTES=[{"prefix":"/product","tag":"agent-browser-auth","requiredComponents":["@method"]}]
TAP_PUBLIC_ROUTES=[{"prefix":"/health"}]
TAP_CACHE_TTL_MS=5000
TAP_REPLAY_DATABASE=./data/replay.db
TAP_TRUSTED_PROXIES=
TAP_ALLOWED_SKEW_SECONDS=0
TAP_UPSTREAM_TIMEOUT_MS=10000
TAP_HEADER_LIMIT=16384
TAP_BODY_LIMIT=1048576

# Optional shared secret injected toward the backend as x-tap-backend-token.
# Strip it on the public side. Prefer a loopback or firewalled upstream.
# TAP_BACKEND_TOKEN=replace-with-a-long-random-backend-token
