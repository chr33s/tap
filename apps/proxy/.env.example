HOST=127.0.0.1
PORT=3001

# Request URL the agent signs. The proxy verifies that URL, then forwards to UPSTREAM_URL.
# A path in UPSTREAM_URL is kept as a prefix: /product/1 -> /shop/product/1 for http://backend/shop.
UPSTREAM_URL=http://127.0.0.1:8080
# Required. Comma-separated origins this proxy serves. A signature for any other
# origin is rejected, so a request signed for another merchant cannot be replayed here.
TAP_ORIGINS=http://127.0.0.1:3001
REGISTRY_URL=http://127.0.0.1:9002
TAP_PROFILE=tap
# Stable replay namespace. Do not take this from the request. Defaults to
# "registry:" + the normalized REGISTRY_URL (trailing slash, no query or
# fragment). Set it explicitly: changing it starts a fresh replay namespace.
TAP_TRUST_SOURCE=registry:http://127.0.0.1:9002/

# JSON arrays. A request must match a protected route or an explicit public route.
# Omit methods, or use "*", to match every method.
# REGISTRY_URL must be https unless its host is loopback.
# Revocation can lag by at most min(TAP_CACHE_TTL_MS, 30000ms, key expires_at).
TAP_PROTECTED_ROUTES=[{"prefix":"/product","tag":"agent-browser-auth","requiredComponents":["@method"]}]
TAP_PUBLIC_ROUTES=[{"prefix":"/health"}]
TAP_CACHE_TTL_MS=5000
TAP_REPLAY_DATABASE=./data/replay.db
TAP_TRUSTED_PROXIES=
TAP_ALLOWED_SKEW_SECONDS=0
TAP_UPSTREAM_TIMEOUT_MS=10000
# Clients that take longer than this to finish sending headers get 408. The
# whole request must arrive within max(this, TAP_UPSTREAM_TIMEOUT_MS + 5000).
TAP_HEADERS_TIMEOUT_MS=10000
TAP_HEADER_LIMIT=16384
TAP_BODY_LIMIT=1048576

# Required when UPSTREAM_URL is not loopback. Injected as x-tap-backend-token
# after the client copy is stripped.
# TAP_BACKEND_TOKEN=replace-with-a-long-random-backend-token
